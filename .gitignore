# --- Ayakashi unified repo root ignores ---
# (math-sdk/.gitignore and web-sdk/.gitignore still apply within their subtrees)

# Claude Code local project config
.claude/

# OS cruft
*.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
env/
.venv/

# Node / build (safety net — web-sdk/.gitignore also covers these)
node_modules/
.svelte-kit/
.turbo/
build/
dist/
.vercel/

# Working font sources (build inputs for bake-logo.py / build-fonts.py). Large +
# include personal-use demo faces (NinjaKage/Scarfire/Shotengai) that must NOT
# ship. Kept local only; the shipped runtime uses static/fonts/*-Subset.woff2.
art/fonts/*.ttf
art/fonts/*.otf
art/fonts/brush/

# Large throwaway art exploration (the source masters live in art/finals/;
# rejected drafts are preserved on disk + in _git_backup, not in git history)
art/rejected/

# Claude dev helpers / scratch (headless screenshot capture)
_shot.jpg
_shot.b64
_shot_server.py

# scraping scratch
pixabay_*
test_dl.*
rc_resp.json
rc_deploy.json
